{
  "name": "omp-ste",
  "version": "0.2.0",
  "description": "Simplified Technical English enforcement for omp using the agent-simple-english engine",
  "type": "module",
  "license": "MIT",
  "files": ["src", "host-patches", "README.md", "LICENSE"],
  "bin": { "omp-ste": "./src/cli.ts" },
  "omp": { "extensions": ["./src/index.ts"] },
  "engines": { "bun": ">=1.3.14" },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "omp": "bun src/cli.ts"
  },
  "patchedDependencies": {
    "@oh-my-pi/pi-coding-agent@18.12.1": "host-patches/18.12.1.patch"
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "18.12.1",
    "agent-simple-english": "0.8.0",
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.12.1",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
